{# Tables + inline styles only: Gmail/Outlook strip <style> and ignore flex/grid/CSS vars.
   {{ p }} and {{ btn }} reach child templates because the body block is declared `scoped`. #}
{% set p = "margin:0 0 16px;font-size:15px;line-height:1.6;color:#50545b" %}
{% set btn = "display:inline-block;background-color:#6747ff;color:#ffffff;padding:12px 22px;border-radius:999px;font-size:14px;font-weight:600;text-decoration:none" %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#eef0f2;padding:32px 12px">
  <tr><td align="center">
    <table role="presentation" width="640" cellpadding="0" cellspacing="0" style="max-width:640px;width:100%;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif">
      <tr><td style="padding:0 6px 16px">
        <a href="https://libertai.io" style="text-decoration:none"><img src="{{ api_url }}/emails/logo.png" width="126" height="22" alt="LibertAI" style="display:block;border:0"></a>
      </td></tr>
      <tr><td style="background-color:#ffffff;border:1px solid #dedfe2;border-radius:16px;padding:36px 40px">
        <p style="{{ p }}">{% if display_name %}Hi {{ display_name }},{% else %}Hi,{% endif %}</p>
        {% block body scoped %}{% endblock %}
        <p style="margin:26px 0 0;font-size:15px;line-height:1.6;color:#111214">Best,<br>The LibertAI team</p>
      </td></tr>
      <tr><td style="padding:22px 6px 0;text-align:center;font-size:12px;line-height:1.6;color:#8a8f97">
        <a href="https://docs.libertai.io" style="color:#60656d;text-decoration:none">Documentation</a>
        &nbsp;&middot;&nbsp;
        <a href="https://github.com/LibertAI" style="color:#60656d;text-decoration:none">GitHub</a>
        &nbsp;&middot;&nbsp;
        <a href="https://x.com/Libertai_DAI" style="color:#60656d;text-decoration:none">X</a>
        {% if unsubscribe_url %}
        <br>You received this email because you have a LibertAI account.
        <a href="{{ unsubscribe_url }}" style="color:#8a8f97">Unsubscribe</a>
        {% endif %}
      </td></tr>
    </table>
  </td></tr>
</table>
